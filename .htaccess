Options +FollowSymLinks
RewriteEngine On
RewriteBase 

# Si le fichier ou le dossier existe, le servir directement
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Exclure les fichiers statiques (CSS, JS, images)
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|eot|ico)$ [NC]
RewriteRule ^ - [L]

# Rediriger toutes les autres requêtes vers index.php
RewriteRule ^ index.php [L]
